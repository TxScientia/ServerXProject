{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)"
  ],
  "timezone": "Europe/Berlin",
  "constraints": {
    "node": "20",
    "npm": "10",
    "python": "3.11"
  },
  "dependencyDashboard": true,
  "labels": ["dependencies"],
  "prConcurrentLimit": 1,
  "branchConcurrentLimit": 1,
  "enabledManagers": [
    "npm",
    "pip_requirements",
    "dockerfile",
    "docker-compose",
    "github-actions"
  ],
  "lockFileMaintenance": {
    "enabled": false
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  },
  "separateMajorMinor": false,
  "separateMultipleMajor": false,
  "separateMinorPatch": false,
  "packageRules": [
    {
      "description": "Group every supported dependency update into a single Renovate PR.",
      "matchManagers": [
        "npm",
        "pip_requirements",
        "dockerfile",
        "docker-compose",
        "github-actions"
      ],
      "groupName": "all dependencies",
      "groupSlug": "all-dependencies"
    }
  ]
}
