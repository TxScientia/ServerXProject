# Backend configuration. Copy to .env (or set in the deployment) and fill in real values.
# The app runs without these in development using insecure fallbacks (with warnings).

# JWT signing secret. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# AES-256 key for encrypting message content at rest (base64-encoded 32 bytes).
# Generate: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# WARNING: if this key is lost or changed, existing encrypted messages become unreadable.
MESSAGE_ENCRYPTION_KEY=

# Comma-separated allowlist of Origins permitted to open the PM WebSocket (CSWSH guard).
# Set to your production frontend origin(s). Defaults to localhost:3000 in dev.
ALLOWED_WS_ORIGINS=https://your-frontend.example.com

# Database. Defaults to a local SQLite file; use Postgres in production.
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/dbname
